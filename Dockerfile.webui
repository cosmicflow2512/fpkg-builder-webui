FROM mcr.microsoft.com/powershell:lts-debian-12

ENV FPKG_REPO_ROOT=/app/fpkg-builder \
    FPKG_WEB_HOST=0.0.0.0 \
    FPKG_WEB_PORT=8080 \
    FPKG_POWERSHELL=pwsh \
    FPKG_PYTHON=python3

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates p7zip-full unar wine64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/fpkg-builder
COPY . /app/fpkg-builder

EXPOSE 8080
CMD ["python3", "webui/server.py"]
